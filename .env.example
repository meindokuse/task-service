# Используется только если config/config.yaml отсутствует (CONFIG_PATH не задан/не найден).
LOG_LEVEL=info

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT=10s

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=task_service
MYSQL_PASSWORD=task_service
MYSQL_DATABASE=task_service
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=30m

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=change-me-in-production
JWT_TTL=24h

EMAIL_FAILURE_RATE=0.2
EMAIL_LATENCY=150ms
EMAIL_BREAKER_MAX_REQUESTS=3
EMAIL_BREAKER_INTERVAL=30s
EMAIL_BREAKER_TIMEOUT=15s
